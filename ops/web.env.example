# /etc/enrolla/web.env
NODE_ENV=production
PORT=3000
# The browser talks to the API at this address. It is baked in at BUILD time too: build with the same value.
NEXT_PUBLIC_API_URL=https://api.example.org
# The website's own server talks to the API on this machine directly (faster, never leaves the server)
API_URL=http://127.0.0.1:4000
# Set to "false" ONLY for a plain-http install on a private network. Always leave unset when using HTTPS.
# COOKIE_SECURE=false
