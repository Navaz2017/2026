# /etc/enrolla/backend.env   (chmod 640, owner root, group enrolla)  — copy from ops/backend.env.example
NODE_ENV=production
PORT=4000

# Postgres on this same server
DATABASE_URL=postgresql://enrolla:CHANGE_THIS_PASSWORD@127.0.0.1:5432/admissions

# Only needed for letters / WhatsApp (background jobs). apt install redis-server
REDIS_URL=redis://127.0.0.1:6379

# Generate each with:  openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
DATA_ENC_KEY=            # exactly 64 hex characters. BACK THIS UP SEPARATELY: without it, authenticator secrets and SMS-phone keys cannot be decrypted.

# Addresses people use (HTTPS if the site is reachable from the internet)
PUBLIC_API_URL=https://api.example.org
WEB_URL=https://example.org
CORS_ORIGINS=https://example.org

# Files stay on this server's disk. No cloud account needed.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/var/lib/enrolla/files

# Email over plain SMTP (any provider; free accounts work). Leave SMTP_HOST empty and emails are only written to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Enrolla <no-reply@example.org>

# WhatsApp linking (only if you use it). Needs Chrome/Chromium installed: see docs/deploy-t620.md
WA_DATA_DIR=/var/lib/enrolla/wa-sessions
WA_MAX_SESSIONS=20
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

ACADEMIC_YEAR=2026/2027
RATE_LIMIT_PER_MIN=300
