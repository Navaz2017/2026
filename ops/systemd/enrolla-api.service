[Unit]
Description=Enrolla API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=enrolla
Group=enrolla
WorkingDirectory=/opt/enrolla/backend
EnvironmentFile=/etc/enrolla/backend.env
ExecStart=/usr/bin/node dist/src/server.js
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/enrolla /var/log/enrolla

[Install]
WantedBy=multi-user.target
