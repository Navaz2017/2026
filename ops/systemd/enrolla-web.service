[Unit]
Description=Enrolla website (Next.js)
After=network-online.target enrolla-api.service
Wants=network-online.target

[Service]
User=enrolla
Group=enrolla
WorkingDirectory=/opt/enrolla/web
EnvironmentFile=/etc/enrolla/web.env
ExecStart=/opt/enrolla/web/node_modules/.bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/enrolla/web/.next/cache

[Install]
WantedBy=multi-user.target
