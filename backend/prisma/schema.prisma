generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// All money is stored as integer minor units (tambala for MWK). Never floats.

enum Role {
  SYSTEM_OWNER
  INSTITUTION_ADMIN
  PARENT
  STUDENT
  TEACHER
}

enum InstitutionType {
  PRIMARY_SCHOOL
  SECONDARY_SCHOOL
  COLLEGE
  UNIVERSITY
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ProgramStatus {
  DRAFT
  PENDING_VERIFICATION // uploaded before institution verified; auto-activates on verification
  ACTIVE
  CLOSED
}

enum ApplicationStatus {
  DRAFT
  AWAITING_PAYMENT
  PAYMENT_SUBMITTED // reference submitted, waiting for SMS match
  SUBMITTED // paid + sent to institution
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  UNDERPAID
}

enum Provider {
  AIRTEL_MONEY
  MPAMBA
}

enum SettlementStatus {
  OPEN
  APPROVED
  PAID
}

model User {
  id           String    @id @default(uuid())
  email        String?   @unique // optional for parents/students (they sign in with their phone); required for school admins and the owner
  phone        String?   @unique
  phoneVerifiedAt DateTime? // set once the SMS/WhatsApp code was entered
  passwordHash String
  role         Role
  fullName     String
  mfaSecret    String? // AES-GCM encrypted base32 TOTP secret
  mfaEnabled   Boolean   @default(false)
  language     String    @default("en") // en | ny (Chichewa) | tum (Tumbuka)
  consentAt    DateTime? // data-protection consent captured at signup
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  parent        ParentProfile?
  student       Student?
  refreshTokens RefreshToken[]
  resets        PasswordReset[]
  recoveryCodes MfaRecoveryCode[]
  otps          OtpCode[]

  @@index([role])
  guardianships  Guardianship[]  @relation("GuardianUser")
  teaching       TeachingAssignment[]
  classesLed     SchoolClass[]   @relation("ClassTeacher")
  announcementReads AnnouncementRead[]
}

// One-time codes for when the authenticator phone is lost. Stored hashed; shown to the user once.
model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One linked WhatsApp (whatsapp-web.js) per institution. The wa-worker process owns the live client;
// the API only reads this row and writes `desired`.
model WhatsAppSession {
  institutionId String      @id
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  desired       Boolean     @default(false) // dashboard wants it connected
  status        String      @default("DISCONNECTED") // DISCONNECTED | STARTING | QR | CODE | CONNECTED | FAILED
  qr            String? // current pairing QR payload (short-lived)
  pairPhone     String? // number the admin asked to link by 8-character code instead of QR (+265...)
  pairingCode   String? // the 8-character code to type into WhatsApp -> Linked devices -> Link with phone number
  phone         String? // linked number once connected
  lastError     String?
  updatedAt     DateTime    @updatedAt
}

// One-time phone codes (signup verification, password reset). Only an HMAC of the code is stored.
model OtpCode {
  id        String    @id @default(uuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  purpose   String // SIGNUP | RESET
  codeHash  String
  channel   String? // whatsapp | sms | dev
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, purpose, createdAt])
}

// The platform's own WhatsApp number (sends verification codes). Managed from the owner's Messaging page.
model PlatformWhatsApp {
  id        String   @id @default("platform")
  desired   Boolean  @default(false)
  status    String   @default("DISCONNECTED") // DISCONNECTED | STARTING | QR | CONNECTED | FAILED
  qr        String?
  pairPhone String?
  pairingCode String?
  phone     String?
  lastError String?
  updatedAt DateTime @updatedAt
}

// Messages waiting to go out through a whatsapp-web.js session. sessionKey = "platform" or an institution id.
// The wa-worker process polls this table; the API only inserts rows (no Redis needed).
model WaOutbox {
  id             String    @id @default(uuid())
  sessionKey     String
  toPhone        String
  text           String
  attachmentKey  String?
  attachmentName String?
  letterId       String?
  status         String    @default("PENDING") // PENDING | SENDING | SENT | FAILED | CANCELLED
  attempts       Int       @default(0)
  maxAttempts    Int       @default(4)
  nextAttemptAt  DateTime  @default(now())
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextAttemptAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  mfa       Boolean   @default(false) // token family was created after a TOTP check
  family    String // rotation family; reuse of a revoked token revokes the whole family
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([family])
}

model Institution {
  id          String             @id @default(uuid())
  name        String
  type        InstitutionType
  country     String             @default("MW")
  district    String?
  address     String?
  contactEmail String
  contactPhone String?
  status      VerificationStatus @default(PENDING)
  reviewNote  String?
  verifiedAt  DateTime?
  // Payout details for month-end settlement
  payoutProvider Provider?
  payoutPhone    String?
  description    String?
  website        String?
  campuses       String[] // e.g. Blantyre, Lilongwe, Mzuzu
  highestLevel   String? // primary/secondary only: STD1..STD8, F1..F6 (highest class the school offers)
  syllabi        String[] // secondary: MSCE and/or CAMBRIDGE
  otherFees      Json? // [{ name, amountMinor, period }] e.g. boarding, student union
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  users     User[]
  documents InstitutionDocument[]
  programs  Program[]
  media     Media[]
  templates LetterTemplate[]
  whatsapp  WhatsAppSession?
  settlements Settlement[]
  applications Application[]
  gradeRequestsIn  GradeRequest[] @relation("GradeRequestTo")
  gradeRequestsOut GradeRequest[] @relation("GradeRequestFrom")

  letterMode       String    @default("IMMEDIATE") // IMMEDIATE = send each letter when the registrar decides; HOLD = keep decisions private until released together
  lettersReleaseAt DateTime? // HOLD: release every pending letter automatically at this moment (null = release by hand)

  @@index([status, type])
  classes       SchoolClass[]
  subjects      Subject[]
  enrolments    Enrolment[]
  announcements Announcement[]
  rosterImports RosterImport[]
}

model InstitutionDocument {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  kind          String // REGISTRATION_CERT, ACCREDITATION, TAX_CLEARANCE, DIRECTOR_ID ...
  storageKey    String // private bucket key; only served via short-lived signed URL
  sha256        String
  mime          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([institutionId])
}

model Program {
  id            String        @id @default(uuid())
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title         String
  level         String // e.g. Form 1, Diploma, Bachelors
  description   String?
  seats         Int
  seatsTaken    Int           @default(0)
  applicationFee Int // minor units, set by institution
  code          String?
  tuitionFeeMinor Int          @default(0) // what the programme costs to study
  tuitionPeriod String         @default("SEMESTER") // SEMESTER | YEAR | TERM | PROGRAMME
  duration      String? // e.g. "4 years"
  entryRequirements String?
  modes         String[] // FULL_TIME PART_TIME WEEKEND EVENING ODEL
  classLevel    String? // schools: STD1..STD8 / F1..F6 — the "programme" is a class level
  syllabus      String? // schools: MSCE | CAMBRIDGE
  opensAt       DateTime?
  closesAt      DateTime?
  status        ProgramStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  applications Application[]
  choices      ApplicationChoice[]

  @@index([institutionId])
  @@index([status, updatedAt])
}

model Media {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  kind          String // IMAGE | VIDEO
  caption       String?
  storageKey    String
  thumbKey      String?
  approved      Boolean     @default(false) // visible to public only once institution verified (+ optional moderation)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([institutionId])
}

model ParentProfile {
  id         String    @id @default(uuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  occupation String
  employer   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  children   Student[]
}

model Student {
  id             String         @id @default(uuid())
  userId         String?        @unique // child records created by a parent have no login
  user           User?          @relation(fields: [userId], references: [id])
  parentId       String?
  parent         ParentProfile? @relation(fields: [parentId], references: [id])
  fullName       String
  dateOfBirth    DateTime
  gender         String?
  currentSchoolId String? // set when the school is registered on the platform -> enables grade requests
  currentSchoolName String?
  profile        Json? // reusable bio data (names, ID, district, address, disability ...) entered once
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  credentials  Credential[]
  applications Application[]
  gradeRequests GradeRequest[]

  @@index([parentId])
  enrolments    Enrolment[]
  guardianships Guardianship[]
}

model Credential {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind       String // SCHOOL_REPORT, MSCE, JCE, PSLCE, TRANSCRIPT, ID, BIRTH_CERT
  title      String
  storageKey String
  sha256     String
  mime       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([studentId])
}

model Application {
  id         String            @id @default(uuid())
  studentId  String
  student    Student           @relation(fields: [studentId], references: [id])
  institutionId String
  institution Institution      @relation(fields: [institutionId], references: [id])
  academicYear String          @default("2026/2027")
  programId  String // first-choice programme (rank 1)
  program    Program           @relation(fields: [programId], references: [id])
  offeredProgramId String? // set on acceptance: which choice the institution offers
  decisionPublishedAt DateTime? // null while a decision is HELD (applicant sees nothing yet); set when the decision + letter are released
  form       Json              @default("{}") // multi-step form answers (education, guardian, sponsor, declaration ...)
  submittedAt DateTime?
  choices    ApplicationChoice[]
  status     ApplicationStatus @default(DRAFT)
  statement  String?
  // Fee snapshot taken at creation so later config changes never alter what the applicant owes.
  feeMinor           Int
  studentServiceFeeMinor Int
  commissionMinor        Int
  totalDueMinor      Int
  decisionNote String?
  decidedAt    DateTime?
  clientId     String?           // idempotency key from offline outbox
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  payments Payment[]
  letter   Letter?
  attachedCredentialIds String[]

  @@unique([studentId, institutionId, academicYear])
  @@unique([clientId])
  @@index([programId, status])
}

// Ranked programme choices within ONE institution (max 3 for colleges/universities, exactly 1 for schools).
model ApplicationChoice {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  programId     String
  program       Program     @relation(fields: [programId], references: [id])
  rank          Int

  @@unique([applicationId, rank])
  @@unique([applicationId, programId])
}

model Payment {
  id            String        @id @default(uuid())
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id])
  provider      Provider
  reference     String // transaction id the applicant typed in
  payerPhone    String // E.164, number that made the cash-out
  amountMinor   Int
  status        PaymentStatus @default(PENDING)
  smsId         String?       @unique // exactly one SMS can confirm a payment
  sms           SmsMessage?   @relation(fields: [smsId], references: [id])
  confirmedAt   DateTime?
  confirmedById String? // set only for manual owner confirmation
  manualReason  String?
  settlementId  String?
  settlement    Settlement?   @relation(fields: [settlementId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // A reference can only ever be used once per provider, across ALL applications.
  @@unique([provider, reference])
  @@index([status])
  @@index([settlementId])
}

model SmsMessage {
  id         String    @id @default(uuid())
  deviceId   String
  device     Device    @relation(fields: [deviceId], references: [id])
  provider   Provider
  reference  String? // primary transaction id (Airtel TID / Mpamba Ref)
  altReference String? // secondary id some Airtel bank deposits carry ("Ref 0003...")
  payerPhone String? // Mpamba includes it; Airtel deposits only carry a name, so this is null there
  payerName  String?
  amountMinor Int?
  rawBody    String
  sender     String
  receivedAt DateTime
  parsedOk   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  payment    Payment?

  @@unique([provider, reference])
  @@unique([provider, altReference])
  @@unique([deviceId, receivedAt, sender])
}

// Android phone running the SMS-forwarder app. The HMAC verifier needs the raw key, so it is stored
// encrypted at rest (AES-256-GCM, key from KMS/env) rather than hashed.
model Device {
  id        String       @id @default(uuid())
  label     String
  keyEnc    String
  revokedAt DateTime?
  lastSeen  DateTime?
  createdAt DateTime     @default(now())
  messages  SmsMessage[]
  nonces    DeviceNonce[]
}

model DeviceNonce {
  deviceId String
  nonce    String
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([deviceId, nonce])
}

model RevenueConfig {
  id                    String   @id @default(uuid())
  // Basis points: 3000 = 30.00%
  institutionCommissionBps Int   // deducted from the institution's application fee
  studentServiceFeeBps     Int   // added on top of the application fee, paid by the student
  effectiveFrom         DateTime @default(now())
  createdById           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([effectiveFrom])
}

model Settlement {
  id            String           @id @default(uuid())
  institutionId String
  institution   Institution      @relation(fields: [institutionId], references: [id])
  periodStart   DateTime
  periodEnd     DateTime
  grossFeesMinor        Int // sum of application fees (institution price)
  commissionMinor       Int // owner share from institution
  studentServiceFeesMinor Int // owner share from students
  netPayableMinor       Int // owed to institution
  status        SettlementStatus @default(OPEN)
  payoutRef     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  payments      Payment[]

  @@unique([institutionId, periodStart, periodEnd])
}

model LetterTemplate {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  kind          String // ACCEPTANCE | REJECTION
  // Handlebars-like {{student.fullName}} {{program.title}} {{institution.name}} {{date}} placeholders; HTML is sanitised.
  body          String
  letterhead    String? // storage key of logo
  signatory     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([institutionId, kind])
}

model Letter {
  id            String      @id @default(uuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])
  storageKey    String
  deliveredVia  String[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model GradeRequest {
  id           String      @id @default(uuid())
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id])
  fromSchoolId String
  fromSchool   Institution @relation("GradeRequestFrom", fields: [fromSchoolId], references: [id])
  toSchoolId   String? // the school being applied to (informational)
  toSchool     Institution? @relation("GradeRequestTo", fields: [toSchoolId], references: [id])
  status       String      @default("PENDING") // PENDING | FULFILLED | DECLINED
  resultCredentialId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([fromSchoolId, status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
}

// Small owner-editable settings (e.g. the numbers applicants pay to).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}


// ============================== School Hub (see docs/school-hub.md) ==============================
// Everything a school owns hangs off an Enrolment (student x school x year) and carries institutionId.

model SchoolClass {
  id             String      @id @default(uuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear   String
  name           String // "Form 3A"
  level          String // F1..F4 (JCE = F1-F2, MSCE = F3-F4) | STD1..STD8
  classTeacherId String?
  classTeacher   User?       @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  createdAt      DateTime    @default(now())

  enrolments  Enrolment[]
  assignments TeachingAssignment[]
  assessments Assessment[]

  @@unique([institutionId, academicYear, name])
}

model Subject {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String

  assignments TeachingAssignment[]
  assessments Assessment[]

  @@unique([institutionId, name])
}

// A teacher teaches a subject in a class (subjectId null = class teacher of that class).
model TeachingAssignment {
  id           String      @id @default(uuid())
  teacherId    String
  teacher      User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId      String
  class        SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      Subject?    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear String

  @@unique([teacherId, classId, subjectId])
  @@index([classId])
}

model Enrolment {
  id            String       @id @default(uuid())
  studentId     String
  student       Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear  String
  classId       String?
  class         SchoolClass? @relation(fields: [classId], references: [id])
  admissionNo   String
  status        String       @default("ACTIVE") // ACTIVE | LEFT | GRADUATED
  joinedAt      DateTime     @default(now())
  leftAt        DateTime?
  importId      String? // roster import that created it (rollback)

  grades     Grade[]
  attendance Attendance[]

  @@unique([institutionId, academicYear, admissionNo])
  @@unique([studentId, institutionId, academicYear])
  @@index([classId])
}

// Who may see / message about a child. phone = roster join key (E.164); guardianUserId is set when that phone logs in (OTP-verified).
model Guardianship {
  id                  String   @id @default(uuid())
  studentId           String
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianUserId      String?
  guardian            User?    @relation("GuardianUser", fields: [guardianUserId], references: [id])
  phone               String
  fullName            String
  relationship        String   @default("PARENT") // PARENT | GUARDIAN | NEXT_OF_KIN
  canViewProgress     Boolean  @default(true)
  canMessage          Boolean  @default(true)
  receivesNotices     Boolean  @default(true)
  isPrimary           Boolean  @default(false)
  blockedInstitutionIds String[] @default([]) // schools that must show this person nothing (court order etc.)
  status              String   @default("ACTIVE") // ACTIVE | REVOKED
  source              String   @default("ROSTER") // ROSTER | CLAIM | ADMISSIONS
  importId            String?
  createdAt           DateTime @default(now())

  @@unique([studentId, phone])
  @@index([phone])
  @@index([guardianUserId])
}

model Assessment {
  id            String      @id @default(uuid())
  institutionId String
  classId       String
  class         SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear  String
  termNo        Int // 1..3
  title         String
  type          String      @default("TEST") // TEST | EXAM | ASSIGNMENT
  maxScore      Int         @default(100)
  date          DateTime?
  publishedAt   DateTime? // families see results only once published
  createdById   String
  createdAt     DateTime    @default(now())

  grades Grade[]

  @@index([classId, termNo])
}

model Grade {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrolmentId  String
  enrolment    Enrolment  @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  score        Float?
  feedback     String? // personalised teacher feedback: visible to the student and their guardians
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, enrolmentId])
}

model Attendance {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  status      String // PRESENT | ABSENT | LATE | EXCUSED
  note        String?
  markedById  String
  notifiedAt  DateTime? // guardians told about this absence/lateness
  updatedAt   DateTime  @updatedAt

  @@unique([enrolmentId, date])
  @@index([date])
}

model Announcement {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  authorId      String
  title         String
  body          String
  audience      String      @default("SCHOOL") // SCHOOL | CLASS
  classIds      String[]    @default([])
  urgent        Boolean     @default(false) // ignores quiet hours (there are none by default)
  alsoWhatsApp  Boolean     @default(false) // secondary channel, from the school's own linked number
  recipients    Int         @default(0)
  createdAt     DateTime    @default(now())

  reads AnnouncementRead[]

  @@index([institutionId, createdAt])
}

model AnnouncementRead {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([announcementId, userId])
}

// A roster upload: PREVIEW (nothing saved yet) -> COMMITTED -> maybe ROLLED_BACK.
model RosterImport {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdById   String
  status        String      @default("PREVIEW")
  fileName      String?
  academicYear  String
  rows          Json
  summary       Json
