{
  "name": "admissions-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test test/*.test.ts",
    "test:int": "NODE_ENV=test INTEGRATION=1 tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "prisma:gen": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "worker": "node dist/src/jobs/worker.js",
    "wa-worker": "node dist/src/jobs/wa-worker.js",
    "dev:worker": "tsx watch --env-file=.env src/jobs/worker.ts",
    "dev:wa": "tsx watch --env-file=.env src/jobs/wa-worker.ts",
    "seed": "tsx --env-file=.env scripts/dev-seed.ts",
    "create-owner": "tsx --env-file=.env scripts/create-owner.ts",
    "reset-mfa": "tsx --env-file=.env scripts/reset-mfa.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.0",
    "@prisma/client": "^6.0.0",
    "bullmq": "^5.30.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.15",
    "otpauth": "^9.5.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^9.5.0",
    "prisma": "^6.0.0",
    "rate-limit-redis": "^4.2.0",
    "whatsapp-web.js": "^1.34.7",
    "ws": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "@types/ws": "^8.18.2",
    "smtp-server": "^3.19.17",
    "tsx": "4.19.2",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "esbuild": "0.23.1"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0"
  }
}
