NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://app:app@localhost:5432/admissions
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-32+chars-random-access-secret
JWT_REFRESH_SECRET=change-me-32+chars-random-refresh-secret
CORS_ORIGINS=http://localhost:3000
S3_BUCKET=admissions-private
S3_REGION=af-south-1
# Device keys for the SMS reader app are stored hashed in DB (Device table), not here.

# --- added in v0.3 ---
WEB_URL=http://localhost:3000            # used in password-reset links
PUBLIC_API_URL=http://localhost:4000     # used for local-driver file URLs
STORAGE_DRIVER=local                     # "s3" is REQUIRED in production
LOCAL_STORAGE_DIR=./.data
DATA_ENC_KEY=                            # 64 hex chars (32 bytes); encrypts device keys + MFA secrets. Required in production
SES_FROM=no-reply@your-domain            # production email sender (AWS SES)
WA_DATA_DIR=./.wa-sessions               # WhatsApp sessions (persistent volume, one wa-worker only)
WA_MAX_SESSIONS=40
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
