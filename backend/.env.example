NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres@localhost:5432/enrolla   # your local Postgres (Postgres.app: user = your Mac username, no password)
REDIS_URL=redis://localhost:6379                            # only needed for decision letters (worker); skip while trying things out
JWT_ACCESS_SECRET=change-me-32+chars-random-access-secret
JWT_REFRESH_SECRET=change-me-32+chars-random-refresh-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:8081    # website + the mobile app's browser build
WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
STORAGE_DRIVER=local                                        # files on this machine's disk, no cloud account
LOCAL_STORAGE_DIR=./.data
# DATA_ENC_KEY=<64 hex chars>                               # required in production: openssl rand -hex 32

# Email (optional; without it emails are printed in the API log)
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASS=  SMTP_FROM="Enrolla <no-reply@example.org>"

# Sign-up codes: with neither of these set, development shows the code on screen and in the API log
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SENDER_ID=
# AT_ENV=sandbox

WA_DATA_DIR=./.wa-sessions                                  # WhatsApp sessions (one wa-worker only)
WA_MAX_SESSIONS=40
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
